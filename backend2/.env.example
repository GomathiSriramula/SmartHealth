# Example env for backend2. Copy to .env and fill in real values.
# NEVER commit the real .env — it's gitignored, keep it that way.

# --- Core ---
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/smart_health

# A strong random value, e.g. `openssl rand -hex 32`. Required — the app
# refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Trusted server-to-server bypass key (optional). Only set this if something
# other than a logged-in browser needs to call the API directly via the
# `x-api-key` header. Leave unset to disable the bypass entirely.
API_KEY=

# --- CORS ---
# Comma-separated list of exact origins allowed to call this API. Must be
# the real deployed frontend URL(s) in production — no wildcards, no
# trailing slash.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used to build links inside emails (e.g. the password-reset link).
FRONTEND_URL=http://localhost:5173

# --- ML service ---
# Where the Python/Flask ml-service is reachable. If unset or unreachable,
# the app falls back to a deterministic rule-based risk analyzer — it does
# NOT fail closed, but predictions will be less accurate.
ML_SERVICE_URL=http://localhost:5005

# --- SMTP (email) ---
# If any of SMTP_HOST/SMTP_USER/SMTP_PASS is missing, the app falls back to
# an auto-created Ethereal test account and logs a preview URL instead of
# sending real email — fine for local dev, NOT fine for production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=SmartHealth System

# --- Bootstrap admin (first run only) ---
# Creates this admin account on startup if it doesn't already exist. Safe to
# leave set permanently (it's a no-op once the account exists), but many
# teams remove it from the environment after the first successful login.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_USERNAME=admin

# --- Optional ---
# Milliseconds; overrides the 48h default window for "consecutive HIGH risk"
# alert triggering. Leave unset unless you specifically need to change it.
# ALERT_TIME_WINDOW_MS=172800000

# Only needed if you're running the optional RabbitMQ event-publishing
# path (utils/publisher.js). Unset = publishing silently no-ops.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
